# 构建产物（不纳入版本库）
app/build
build
core/target
# 单测临时目录（backup_export 测试按 CARGO_MANIFEST_DIR 拼 target/tmp 放测试数据；
# 与「工作区内放行、%TEMP% 被拒」的沙箱口径配套,见该文件测试注释）
core/nbcore/target
dist
# 构建期临时目录：本机 %TEMP% 落在沙箱拒写区时，把 TMP/TEMP 指到这里再构建
# （MSVC 链接器在此写 lnk*.tmp，见 docs/progress.md 的 cc-rs 踩坑记录）
.buildtmp
# 待办交互验收（--todo-flow 未指定 --data-dir 时的兜底数据目录）
acceptance-data
# 启动冒烟临时数据目录与截图（--data-dir + --screenshot 手工验证用）
smoke-data
smoke.png
# 冒烟宿主的二进制产物:只留源码(smoke_host.cpp),DLL/exe 由构建生成。
# 历史上这两个文件曾被提交,已用 git rm --cached 从索引移除(本地副本保留);
# 换机后按下文「快速开始」用 cl 现编即可,不需要版本库里的二进制。
tools/smoke_host/*.dll
tools/smoke_host/*.exe
/.workbuddy-ai
.vscode
/data
/.workbuddy
.workbuddy
.workbuddy
